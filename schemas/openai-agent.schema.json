{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFlow OpenAI Agent Metadata",
  "type": "object",
  "required": ["interface"],
  "additionalProperties": false,
  "properties": {
    "interface": {
      "type": "object",
      "required": ["display_name", "short_description", "default_prompt"],
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "short_description": {
          "type": "string",
          "minLength": 1
        },
        "default_prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

