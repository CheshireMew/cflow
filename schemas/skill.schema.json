{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFlow Skill Metadata",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^cflow(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}

